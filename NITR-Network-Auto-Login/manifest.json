{
  "manifest_version": 3,
  "name": "NITR Network Auto-Login",
  "version": "1.4",
  "description": "Automatically logs into the campus captive portal when the session expires.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
